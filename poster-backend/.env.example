# ---- Django core ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Asia/Kolkata

# ---- MySQL database ----
DB_NAME=rang_poster_db
DB_USER=rang_poster
DB_PASSWORD=change-me
DB_HOST=localhost
